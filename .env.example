# === Required ===
GROQ_API_KEY=gsk_your_key_here

# === LLM Models (Groq) ===
LLM_PLANNER_MODEL=openai/gpt-oss-120b
LLM_PLANNER_FALLBACK=openai/gpt-oss-20b
LLM_CLASSIFIER_MODEL=openai/gpt-oss-20b

# === STT Model (Groq Whisper) ===
STT_MODEL=whisper-large-v3-turbo

# === TTS Provider ===
# Options: "edge" (default, free neural voices), "elevenlabs" (if key provided), "browser"
TTS_PROVIDER=edge

# === ElevenLabs (optional) ===
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# === Sarvam (optional, OFF by default) ===
SARVAM_ENABLED=false
SARVAM_API_KEY=
SARVAM_BUDGET_CREDITS=100

# === App Settings ===
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_LANGUAGE=en
REMINDER_RETRY_DELAY_SECONDS=60
OVERDUE_POLICY=fire_now

# === Daily Usage Limits ===
DAILY_TOKEN_LIMIT=100000
DAILY_STT_REQUESTS=200
DAILY_TTS_REQUESTS=300
